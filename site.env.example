# Site settings for a four-node switchless ring. Copy to site.env (git-ignored) and edit.
HEAD_ADDR=10.100.0.2                      # rank 0's address every rank can reach (bootstrap and control line)
WORKERS="user@10.100.200.1 user@10.100.0.3 user@10.100.210.4"   # ranks 1..3 in ring order from the head
SOCKET_IFNAME=ring0                       # interface for NCCL's bootstrap sockets
IB_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1          # RoCE devices on every node
GRAPH_DIR=$HOME/.local/state/glm53-tensorfold                  # per-rank NCCL ring graph: nccl-graph-rank<N>.xml on rank N's node
MODEL_DIR=$HOME/models/GLM-5.3-Flash-FP4-Local-nvidia          # nvidia/GLM-5.3-Flash-FP4-Local @ 76348ddb on every node
DRAFTER_DIR=$HOME/models/GLM-5.3-Flash-DFlash2-bf582e4e           # incoai/GLM-5.3-Flash-DFlash2 @ bf582e4e on every node; empty: the model's own MTP drafts
HOST=127.0.0.1                            # rank 0's API address (no key: keep it local or behind a firewall rule)
PORT=8888
CONTEXT=245760
SERVED_NAME=GLM-5.3-Flash-FP4-Local
EXTRA_ARGS=""                             # extra `tensorfold serve` arguments, the same on every rank
EXTRA_ENV=""                              # extra -e NAME=value pairs, the same on every rank
